    },
    "auth.checkEmail.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reset link is on its way to %@. It expires in 30 minutes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıfırlama bağlantısı %@ adresine gönderildi. Bağlantı 30 dakika geçerlidir."
          }
        }
      },
      "comment": "%@ = email address, medium weight"
    },
    "auth.checkEmail.hint": {
      "extractionState": "manual",
      "localizations": {
