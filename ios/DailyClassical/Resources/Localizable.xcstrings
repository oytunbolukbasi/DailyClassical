        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile giriş yapılamadı. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "auth.apple.error.noEmail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn’t share an email address. Please try again, or sign up with your email."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bir e-posta adresi paylaşmadı. Lütfen tekrar deneyin ya da e-postanızla kaydolun."
          }
        }
      }
    },
    "auth.apple.error.otherAppleID": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email is already linked to a different Apple ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-posta adresi başka bir Apple Kimliği’ne bağlı."
          }
        }
