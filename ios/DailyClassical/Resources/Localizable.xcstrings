{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "about.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One classical work a day, with a guide you read while it plays. Each piece is paired with a painting, and every guide is written for listeners, not musicians."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün bir klasik eser ve çalarken okuyacağınız bir rehber. Her eser bir tabloyla eşleşir; rehberler müzisyenler için değil, dinleyiciler için yazılır."
          }
        }
      }
    },
    "about.credit.paintings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paintings"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablolar"
          }
        }
      }
    },
    "about.credit.paintings.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public-domain works, reproduced from Wikimedia Commons and museum collections."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu malı eserler; Wikimedia Commons ve müze koleksiyonlarından alınmıştır."
          }
        }
      }
    },
    "about.credit.recordings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording data"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt bilgileri"
          }
        }
      }
    },
    "about.credit.recordings.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Albums and links from Spotify. Listening-stop times follow each piece’s reference recording."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Albümler ve bağlantılar Spotify’dan. Dinleme durağı zamanları her eserin referans kaydına göredir."
          }
        }
      }
    },
    "about.credit.typeface": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typeface"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazı karakteri"
          }
        }
      }
    },
    "about.credit.typeface.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Literata by TypeTogether, under the SIL Open Font License."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeTogether’ın tasarladığı Literata, SIL Open Font License ile."
          }
        }
      }
    },
