      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with Apple"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ile Devam Et"
