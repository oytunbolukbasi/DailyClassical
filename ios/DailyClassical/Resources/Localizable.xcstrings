        }
      },
      "comment": "Apple's approved Sign in with Apple title; keep Apple's exact wording and casing."
    },
    "auth.apple.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Apple didn’t work. Please try again."
          }
