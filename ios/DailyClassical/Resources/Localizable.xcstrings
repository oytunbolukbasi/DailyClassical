          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "account.delete.alert.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sil"
          }
        }
      }
    },
    "account.delete.alert.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account and favourites will be removed permanently. This cannot be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınız ve favorileriniz kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "account.delete.alert.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silinsin mi?"
          }
        }
      }
    },
    "account.delete.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şeyler ters gitti. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "account.delete.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Try again when you reconnect."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. Bağlantı geri geldiğinde tekrar deneyin."
          }
        }
      }
    },
    "account.delete.error.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "account.delete.error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account not deleted"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silinemedi"
          }
        }
      }
    },
    "account.delete.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes your account and favourites permanently. Premium purchases are tied to your Apple ID and are unaffected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabınızı ve favorilerinizi kalıcı olarak siler. Premium satın alımlarınız Apple Kimliğinize bağlıdır ve etkilenmez."
          }
        }
      }
    },
