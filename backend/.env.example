# Neon → Project → Connection details. Pooled for the app, direct for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/dailyclassical?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/dailyclassical?sslmode=require
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
PORT=3100
# Resend → API Keys (sending access, domain dailyclassical.co). Leave empty in development to log emails instead.
RESEND_API_KEY=
EMAIL_FROM=DailyClassical <hello@dailyclassical.co>
# Public URL of this API (links in emails point at /reset-password here). Use http://localhost:3100 locally.
PUBLIC_API_URL=https://api.dailyclassical.co
