{
  "name": "dailyclassical-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "content:build": "tsx scripts/build-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts && tsx --env-file-if-exists=.env scripts/seed-schedule.ts",
    "fixtures": "tsx scripts/export-fixtures.ts && tsx scripts/export-schedule.ts",
    "images": "tsx scripts/optimize-images.ts",
    "emails:preview": "tsx scripts/preview-emails.ts",
    "test-user": "tsx --env-file-if-exists=.env scripts/create-test-user.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
